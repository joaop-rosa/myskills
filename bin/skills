#!/usr/bin/env bash
# Wrapper executável para o CLI de skills com resolução segura de symlinks

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"

exec python3 "${REPO_DIR}/cli.py" "$@"
